{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Chrome (dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173/qr/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev",
      "postDebugTask": "Stop servers",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Debug: Edge (dev)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173/qr/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev",
      "postDebugTask": "Stop servers",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Debug: Chrome (production preview)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4173/qr/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "preview",
      "postDebugTask": "Stop servers",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Attach: Chrome (port 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "urlFilter": "http://localhost:*/qr/*",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
